# Caddy site file for Nextaar — installed at /srv/edge/sites/nextaar.caddy.
# Reload after editing:
#   docker exec edge-caddy caddy reload --config /etc/caddy/Caddyfile
#
# Caddy requests a Let's Encrypt cert as soon as a block loads, so only list a
# hostname here once its A record already points at 194.5.175.170.
lastaar.com, www.lastaar.com {
	reverse_proxy nextaar-app:3000
}
